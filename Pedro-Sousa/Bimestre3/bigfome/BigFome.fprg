<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="pa"/>
        <attribute name="authors" value="jesia"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-28 09:07:32 "/>
        <attribute name="created" value="amVzaWE7REVTS1RPUC00NTNIRjhDOzIwMjYtMDgtMjc7IjA1OjIxOjA0ICI7MjcyMg=="/>
        <attribute name="edited" value="amVzaWE7REVTS1RPUC00NTNIRjhDOzIwMjYtMDgtMjg7IjA5OjE3OjIxICI7NzsyODQ1"/>
        <attribute name="edited" value="cGVkcm9fMjYwOTI7TEFCNE1BUTE0OzIwMjYtMDktMjg7IjA5OjA3OjMyICI7MTsyNzg4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="prod1, qntd1, prod2, qntd2, prod3, qntd3" type="Integer" array="False" size=""/>
            <declare name="nomeprod1, nomeprod2, nomeprod3" type="String" array="False" size=""/>
            <declare name="codhambu, codchess, codcchr, codsandu, codrefri, codsuco, codsobrem" type="Real" array="False" size=""/>
            <declare name="codprod1, codprod2, codprod3" type="Real" array="False" size=""/>
            <declare name="qntdtotal" type="Integer" array="False" size=""/>
            <declare name="choose1, choose2" type="String" array="False" size=""/>
            <declare name="cardapio" type="String" array="False" size=""/>
            <assign variable="codhambu" expression="26.99"/>
            <assign variable="codchess" expression="35.99"/>
            <assign variable="codcchr" expression="18.50"/>
            <assign variable="codsandu" expression="38.9"/>
            <assign variable="codrefri" expression="9.50"/>
            <assign variable="codsuco" expression="15.45"/>
            <assign variable="codsobrem" expression="25.00"/>
            <output expression="&quot;Bem Vindo ao Restaurante BigFome!&quot;" newline="True"/>
            <output expression="&quot;Gostaria de ver nosso card&#225;pio?(s ou n)&quot;" newline="True"/>
            <input variable="cardapio"/>
            <if expression="cardapio == &quot;s&quot;">
                <then>
                    <output expression="&quot;1- Hamb&#250;rguer&quot;" newline="True"/>
                    <output expression="&quot;2- Cheeseburguer&quot;" newline="True"/>
                    <output expression="&quot;3- Cachorro-quente&quot;" newline="True"/>
                    <output expression="&quot;4- Sandu&#237;che&quot;" newline="True"/>
                    <output expression="&quot;5- Refrigerante&quot;" newline="True"/>
                    <output expression="&quot;6- Suco&quot;" newline="True"/>
                    <output expression="&quot;7- Sobremesa&quot;" newline="True"/>
                    <output expression="&quot;Qual produto gostaria de escolher? (insira o n&#250;mero do respectivo produto)&quot;" newline="True"/>
                    <input variable="prod1"/>
                    <if expression="prod1 == 1">
                        <then>
                            <assign variable="codprod1" expression="codhambu"/>
                            <assign variable="nomeprod1" expression="&quot;Hamb&#250;rguer&quot;"/>
                        </then>
                        <else>
                            <if expression="prod1 == 2">
                                <then>
                                    <assign variable="codprod1" expression="codchess"/>
                                    <assign variable="nomeprod1" expression="&quot;Cheeseburguer&quot;"/>
                                </then>
                                <else>
                                    <if expression="prod1 == 3">
                                        <then>
                                            <assign variable="codprod1" expression="codcchr"/>
                                            <assign variable="nomeprod1" expression="&quot;Cachorro-quente&quot;"/>
                                        </then>
                                        <else>
                                            <if expression="prod1 == 4">
                                                <then>
                                                    <assign variable="codprod1" expression="codsandu"/>
                                                    <assign variable="nomeprod1" expression="&quot;Sanduiche&quot;"/>
                                                </then>
                                                <else>
                                                    <if expression="prod1 == 5">
                                                        <then>
                                                            <assign variable="codprod1" expression="codrefri"/>
                                                            <assign variable="nomeprod1" expression="&quot;Refrigerante&quot;"/>
                                                        </then>
                                                        <else>
                                                            <if expression="prod1 = 6">
                                                                <then>
                                                                    <assign variable="codprod1" expression="codsuco"/>
                                                                    <assign variable="nomeprod1" expression="&quot;Suco&quot;"/>
                                                                </then>
                                                                <else>
                                                                    <if expression="prod1 = 7">
                                                                        <then>
                                                                            <assign variable="codprod1" expression="codsobrem"/>
                                                                            <assign variable="nomeprod1" expression="&quot;Sobremesa&quot;"/>
                                                                        </then>
                                                                        <else>
                                                                            <output expression="&quot;Op&#231;&#227;o Inv&#225;ida&quot;" newline="True"/>
                                                                        </else>
                                                                    </if>
                                                                </else>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                    <output expression="&quot;Gostaria de qual quantidade desse produto?&quot;" newline="True"/>
                    <input variable="qntd1"/>
                    <assign variable="qntdtotal" expression="qntd1 * codprod1"/>
                    <output expression="&quot;Gostaria de pedir mais algum produto?(s ou n)&quot;" newline="True"/>
                    <input variable="choose1"/>
                    <if expression="choose1 == &quot;s&quot;">
                        <then>
                            <input variable="prod2"/>
                            <if expression="prod2 == 1">
                                <then>
                                    <assign variable="codprod2" expression="codhambu"/>
                                    <assign variable="nomeprod2" expression="&quot;Hamburguer&quot;"/>
                                </then>
                                <else>
                                    <if expression="prod2 == 2">
                                        <then>
                                            <assign variable="codprod2" expression="codchess"/>
                                            <assign variable="nomeprod2" expression="&quot;Cheeseburguer&quot;"/>
                                        </then>
                                        <else>
                                            <if expression="prod2 == 3">
                                                <then>
                                                    <assign variable="codprod2" expression="codcchr"/>
                                                    <assign variable="nomeprod2" expression="&quot;Cachorro-quente&quot;"/>
                                                </then>
                                                <else>
                                                    <if expression="prod2 == 4">
                                                        <then>
                                                            <assign variable="codprod2" expression="codsandu"/>
                                                            <assign variable="nomeprod2" expression="&quot;Sandu&#237;che&quot;"/>
                                                        </then>
                                                        <else>
                                                            <if expression="prod2 == 5">
                                                                <then>
                                                                    <assign variable="codprod2" expression="codrefri"/>
                                                                    <assign variable="nomeprod2" expression="&quot;Refrigerante&quot;"/>
                                                                </then>
                                                                <else>
                                                                    <if expression="prod2 == 6">
                                                                        <then>
                                                                            <assign variable="codprod2" expression="codsuco"/>
                                                                            <assign variable="nomeprod2" expression="&quot;Suco&quot;"/>
                                                                        </then>
                                                                        <else>
                                                                            <if expression="prod2 == 7">
                                                                                <then>
                                                                                    <assign variable="codprod2" expression="codsobrem"/>
                                                                                    <assign variable="nomeprod2" expression="&quot;Sobremesa&quot;"/>
                                                                                </then>
                                                                                <else>
                                                                                    <output expression="&quot;Op&#231;&#227;o Inv&#225;lida&quot;" newline="True"/>
                                                                                </else>
                                                                            </if>
                                                                        </else>
                                                                    </if>
                                                                </else>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                            <output expression="&quot;Gostaria de qual quantidade desse produto?&quot;" newline="True"/>
                            <input variable="qntd2"/>
                            <assign variable="qntdtotal" expression="qntdtotal + qntd2 * codprod2"/>
                            <output expression="&quot;Gostaria de adicionar mais algum produto ao seu pedido?(s ou n)&quot;" newline="True"/>
                            <input variable="choose2"/>
                            <if expression="choose2 == &quot;s&quot;">
                                <then>
                                    <input variable="prod3"/>
                                    <if expression="prod3 == 1">
                                        <then>
                                            <assign variable="codprod3" expression="codhambu"/>
                                            <assign variable="nomeprod3" expression="&quot;Hamburguer&quot;"/>
                                        </then>
                                        <else>
                                            <if expression="prod3 == 2">
                                                <then>
                                                    <assign variable="codprod3" expression="codchess"/>
                                                    <assign variable="nomeprod3" expression="&quot;Cheeseburguer&quot;"/>
                                                </then>
                                                <else>
                                                    <if expression="prod3 == 3">
                                                        <then>
                                                            <assign variable="codprod3" expression="codcchr"/>
                                                            <assign variable="nomeprod3" expression="&quot;Cachorro-quente&quot;"/>
                                                        </then>
                                                        <else>
                                                            <if expression="prod3 == 4">
                                                                <then>
                                                                    <assign variable="codprod3" expression="codsandu"/>
                                                                    <assign variable="nomeprod3" expression="&quot;Sanduiche&quot;"/>
                                                                </then>
                                                                <else>
                                                                    <if expression="prod3 == 5">
                                                                        <then>
                                                                            <assign variable="codprod3" expression="codrefri"/>
                                                                            <assign variable="nomeprod3" expression="&quot;Refrigerante&quot;"/>
                                                                        </then>
                                                                        <else>
                                                                            <if expression="prod3 == 6">
                                                                                <then>
                                                                                    <assign variable="codprod3" expression="codsuco"/>
                                                                                    <assign variable="nomeprod3" expression="&quot;Suco&quot;"/>
                                                                                </then>
                                                                                <else>
                                                                                    <if expression="prod3 == 7">
                                                                                        <then>
                                                                                            <assign variable="codprod3" expression="codsobrem"/>
                                                                                            <assign variable="nomeprod3" expression="&quot;Sobremesa&quot;"/>
                                                                                        </then>
                                                                                        <else>
                                                                                            <output expression="&quot;Op&#231;&#227;o Inv&#225;lida&quot;" newline="True"/>
                                                                                        </else>
                                                                                    </if>
                                                                                </else>
                                                                            </if>
                                                                        </else>
                                                                    </if>
                                                                </else>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                    <output expression="&quot;Gostaria de qual quantidade desse produto?&quot;" newline="True"/>
                                    <input variable="qntd3"/>
                                    <assign variable="qntdtotal" expression="qntdtotal + qntd3 * codprod3"/>
                                    <output expression="&quot;Total: R$&quot;&amp; qntdtotal &amp;&quot;/ Pedido:&quot; &amp; nomeprod1 &amp; &quot;-&quot; &amp; qntd1 &amp; &quot;/&quot; &amp; nomeprod2 &amp; &quot;-&quot; &amp; qntd2 &amp; &quot;/&quot; &amp; nomeprod3 &amp; &quot;-&quot; &amp; qntd3" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Total: R$&quot;&amp; qntdtotal &amp;&quot;/ Pedido:&quot; &amp; nomeprod1 &amp; &quot;-&quot; &amp; qntd1 &amp; &quot;/&quot; &amp; nomeprod2 &amp; &quot;-&quot; &amp; qntd2" newline="True"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;Total: R$&quot;&amp; qntdtotal &amp;&quot;/ Pedido:&quot; &amp; nomeprod1 &amp; &quot;-&quot; &amp; qntd1" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Tenha um &#243;timo dia&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
