<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="bhaskara"/>
        <attribute name="authors" value="pedro_26092"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 09:38:34 "/>
        <attribute name="created" value="cGVkcm9fMjYwOTI7TEFCNE1BUTE0OzIwMjYtMDgtMTA7IjA5OjIwOjAyICI7MjY2Mg=="/>
        <attribute name="edited" value="cGVkcm9fMjYwOTI7TEFCNE1BUTE0OzIwMjYtMDgtMTA7IjA5OjM4OjM0ICI7MzsyNzg2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Insira o item A da equa&#231;&#227;o&quot;" newline="True"/>
            <declare name="A" type="Real" array="False" size=""/>
            <input variable="a"/>
            <output expression="&quot;Insira o item B da equa&#231;&#227;o&quot;" newline="True"/>
            <declare name="B" type="Real" array="False" size=""/>
            <input variable="b"/>
            <output expression="&quot;Insira o item C da equa&#231;&#227;o&quot;" newline="True"/>
            <declare name="C" type="Real" array="False" size=""/>
            <input variable="c"/>
            <declare name="bq" type="Real" array="False" size=""/>
            <assign variable="bq" expression="b*b"/>
            <declare name="da" type="Real" array="False" size=""/>
            <assign variable="da" expression="a*2"/>
            <declare name="delta" type="Real" array="False" size=""/>
            <assign variable="delta" expression="bq - 4*a*c"/>
            <declare name="rdelta" type="Real" array="False" size=""/>
            <assign variable="rdelta" expression="delta^ 0.5"/>
            <if expression="delta &lt; 0">
                <then>
                    <output expression="&quot;O valor de delta &#233; menor que 0&quot;" newline="True"/>
                </then>
                <else>
                    <declare name="x1" type="Real" array="False" size=""/>
                    <assign variable="x1" expression="(-b + rdelta) / da"/>
                    <declare name="x2" type="Real" array="False" size=""/>
                    <assign variable="x2" expression="(-b - rdelta) / da"/>
                    <output expression="&quot;x1 =&quot;&amp; x1" newline="True"/>
                    <output expression="&quot;x2 =&quot;&amp; x2" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
