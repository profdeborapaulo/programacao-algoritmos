<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="voto"/>
        <attribute name="authors" value="pedro_26092"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 09:19:07 "/>
        <attribute name="created" value="cGVkcm9fMjYwOTI7TEFCNE1BUTE0OzIwMjYtMDgtMTA7IjA5OjAxOjIwICI7MjY2MQ=="/>
        <attribute name="edited" value="cGVkcm9fMjYwOTI7TEFCNE1BUTE0OzIwMjYtMDgtMTA7IjA5OjE5OjA3ICI7MTsyNzgz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Insira seu nome&quot;" newline="True"/>
            <declare name="Nome" type="String" array="False" size=""/>
            <input variable="Nome"/>
            <output expression="&quot;Insira sua idade&quot;" newline="True"/>
            <declare name="idade" type="Integer" array="False" size=""/>
            <input variable="idade"/>
            <if expression="idade &gt;= 16 &amp;&amp; idade &lt; 18">
                <then>
                    <output expression="&quot;Seu voto &#233; facultativo (opcional)&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="idade &gt;= 18 &amp;&amp; idade &lt; 70">
                        <then>
                            <output expression="&quot;Seu voto &#233; obrigat&#243;rio&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="idade &gt;= 70">
                                <then>
                                    <output expression="&quot;Senhor(a), Seu voto &#233; facultativo (opcional)&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Voc&#234; &#233; incapaz de votar&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
