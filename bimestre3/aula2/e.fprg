        <attribute name="edited" value="cmF1bF8yNjI2MztMQUI0TUFRMTY7MjAyNi0wOC0xNzsiMDk6MTE6MTggIjsxOzI2ODQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="digito" type="Integer" array="False" size=""/>
            <input variable="digitoD"/>
            <output expression="&quot;1: Suporte T&#233;cnico&quot;" newline="True"/>
            <output expression="&quot;2: Financ&#233;iro&quot;" newline="True"/>
            <output expression="&quot;3: Vendas&quot;" newline="True"/>
            <output expression="&quot;4: Falar com atendente&quot;" newline="True"/>
            <output expression="&quot;5: Sair&quot;" newline="True"/>
            <if expression="digito = 1">
                <then>
                    <output expression="&quot;Voc&#234; escolheu Suporte T&#233;cnico&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="digito = 2">
                        <then>
                            <output expression="&quot;Voc&#234; escolheu Financ&#233;iro&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="digito = 3">
                                <then>
                                    <output expression="&quot;Voc&#234; escolheu Vendas&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="digito = 4">
                                        <then>
                                            <output expression="&quot;Voc&#234; escolheu Falar com atendente&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <if expression="digito = 5">
                                                <then>
                                                    <output expression="&quot;Voc&#234; escolheu Sair&quot;" newline="True"/>
                                                </then>
                                                <else/>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
