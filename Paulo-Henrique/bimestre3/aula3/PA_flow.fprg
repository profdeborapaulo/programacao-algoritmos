                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="codigoProd != 7">
                <then>
                    <output expression="&quot;Deseja escolher outro produto?&quot;" newline="True"/>
                    <output expression="&quot;Digite outro c&#243;digo ou 7 para finalizar: &quot;" newline="True"/>
                    <input variable="codigoProd"/>
