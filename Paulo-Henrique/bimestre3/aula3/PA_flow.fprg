            <declare name="quantPed3" type="Integer" array="False" size=""/>
            <declare name="subtotal1" type="Real" array="False" size=""/>
            <declare name="subtotal2" type="Real" array="False" size=""/>
            <declare name="subtotal3" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <assign variable="produto1" expression="&quot;&quot;"/>
            <assign variable="produto2" expression="&quot;&quot;"/>
            <assign variable="produto3" expression="&quot;&quot;"/>
            <assign variable="subtotal1" expression="0"/>
            <assign variable="subtotal2" expression="0"/>
            <assign variable="subtotal3" expression="0"/>
