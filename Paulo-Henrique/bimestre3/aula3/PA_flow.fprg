    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="codigoProd" type="Integer" array="False" size=""/>
            <declare name="quantidade" type="Integer" array="False" size=""/>
            <declare name="produto1" type="String" array="False" size=""/>
            <declare name="produto2" type="String" array="False" size=""/>
            <declare name="produto3" type="String" array="False" size=""/>
            <declare name="quantPed1" type="Integer" array="False" size=""/>
