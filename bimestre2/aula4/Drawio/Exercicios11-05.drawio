  <diagram name="Exercicio1" id="F7h3z-A78v40SIjKAIFv">
    <mxGraphModel dx="1157" dy="566" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="db3E64rlvYJxwJv73ldi-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Exercício 1&lt;/h1&gt;&lt;p&gt;Desenvolver um programa em JavaScript para verificar se o número da variável é par ou ímpar.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="db3E64rlvYJxwJv73ldi-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;JavaScript&lt;/h1&gt;&lt;p&gt;let num = 8;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;if(num % 2 == 0){&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; console.log(&quot;Seu número é par&quot;);&lt;/p&gt;&lt;p&gt;} else {&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; console.log(&quot;Seu número é ímpar&quot;);&lt;/p&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="180" x="10" y="140" as="geometry" />
        </mxCell>
