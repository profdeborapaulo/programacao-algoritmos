  <diagram name="Exercicio3" id="9DYNcSmzVnmWzPSXenye">
    <mxGraphModel dx="1286" dy="629" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="sbhzijlZ1ZvnZrD6POHH-0" />
        <mxCell id="sbhzijlZ1ZvnZrD6POHH-1" parent="sbhzijlZ1ZvnZrD6POHH-0" />
        <mxCell id="sbhzijlZ1ZvnZrD6POHH-2" parent="sbhzijlZ1ZvnZrD6POHH-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Exercício 3&lt;/h1&gt;&lt;p&gt;A família &quot;Carrara&quot; deseja comprar um imóvel. Pelas regras de financiamento, a prestação do financiamento não poderá exceder a 30% do valor da renda. o programa deverá receber o valor total da renda da família, o valor total do financiamento dividido pelo número de meses para pagamento. O programa deverá informar o valor máximo permitido para a parcela e se foi aprovado ou reprovado o plano.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="290" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="sbhzijlZ1ZvnZrD6POHH-3" parent="sbhzijlZ1ZvnZrD6POHH-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;JavaScript&lt;/h1&gt;&lt;p&gt;let rendafam = 1000;&lt;/p&gt;&lt;p&gt;let meses = 6;&lt;/p&gt;&lt;p&gt;let financ = 1000;&lt;/p&gt;&lt;p&gt;let prestac = financ / meses;&lt;/p&gt;&lt;p&gt;let porc = rendafam * 0.3;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;console.log(&quot;Valor máximo:&quot;, porc);&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;if(prestac &amp;gt; porc){&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; console.log(&quot;Reprovado. Valor Excedido&quot;);&lt;/p&gt;&lt;p&gt;} else{&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; console.log(&quot;Aprovado! Valor dentro do máximo&quot;);&lt;/p&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
          <mxGeometry height="430" width="230" x="10" y="200" as="geometry" />
        </mxCell>
        <mxCell id="sbhzijlZ1ZvnZrD6POHH-4" edge="1" parent="sbhzijlZ1ZvnZrD6POHH-1" source="sbhzijlZ1ZvnZrD6POHH-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="sbhzijlZ1ZvnZrD6POHH-7" value="">
