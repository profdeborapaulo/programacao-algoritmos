  <diagram name="Exercicio2" id="xc-xcEUMptqVXkmvGe8f">
    <mxGraphModel dx="1218" dy="596" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="of2TLyzM1jzMJK2sg4g_-0" />
        <mxCell id="of2TLyzM1jzMJK2sg4g_-1" parent="of2TLyzM1jzMJK2sg4g_-0" />
        <mxCell id="of2TLyzM1jzMJK2sg4g_-2" parent="of2TLyzM1jzMJK2sg4g_-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Exercício 2&lt;/h1&gt;&lt;p&gt;Uma empresa necessita de um programa que calcule a quantidade de horas extras semanais de um funcionário. Sabendo que a carga semanal é de 44 horas, o programa deverá exibir um alerta se a quantidade de horas exceder este limite. Caso contrário, exibir a mensagem que não houve horas extras pelo funcionário.&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="of2TLyzM1jzMJK2sg4g_-3" parent="of2TLyzM1jzMJK2sg4g_-1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;JavaScript&lt;/h1&gt;&lt;p&gt;let hr = 44;&lt;/p&gt;&lt;p&gt;let extra = 0;&lt;/p&gt;&lt;p&gt;let total = hr + extra;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;if(total &amp;gt; hr){&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; console.log(&quot;ALERTA! Quantidade de Horas excedidas:&quot;, extra);&lt;/p&gt;&lt;p&gt;} else {&lt;/p&gt;&lt;p&gt;&amp;nbsp; &amp;nbsp; console.log(&quot;Não houve horas extras!&quot;);&lt;/p&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
          <mxGeometry height="330" width="220" x="10" y="170" as="geometry" />
        </mxCell>
