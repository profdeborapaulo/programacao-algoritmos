  <diagram name="Página-1" id="SbOVN97OYL6axvyejdX7">
    <mxGraphModel dx="1664" dy="914" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" background="light-dark(#FFFFFF,#121212)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3luU2yEl30hkSJjVnGW9-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="440" width="558.14" x="133.93" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="3luU2yEl30hkSJjVnGW9-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontColor=light-dark(#000000,#211616);" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Projeto Bimestral&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;div style=&quot;&quot;&gt;Exercício: Planejamento de Churrasco – Buffet F&amp;amp;F&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;O Buffet F&amp;amp;F – Festa Feliz está em expansão e precisa de um sistema simples para&lt;/div&gt;&lt;div style=&quot;&quot;&gt;ajudar no planejamento de compras de alimentos para seus eventos, evitando&lt;/div&gt;&lt;div style=&quot;&quot;&gt;desperdícios e garantindo que não falte comida. Você foi contratado para desenvolver&lt;/div&gt;&lt;div style=&quot;&quot;&gt;um programa em JavaScript (executado no terminal com Node.js) para auxiliar nesse&lt;/div&gt;&lt;div style=&quot;&quot;&gt;processo.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;O objetivo do sistema está em criar um programa que:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Receba o número de convidados&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Valide essa informação&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Calcule a quantidade de alimentos necessários&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Classifique o evento conforme o tamanho&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Regras de negócio&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;1. Quantidade mínima de convidados O buffet só aceita eventos com no mínimo&lt;/div&gt;&lt;div style=&quot;&quot;&gt;50 pessoas.&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Portanto:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Se o número for menor que 50:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Exibir: Número insuficiente de convidados para contratar o buffet.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Caso contrário:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Continuar o cálculo normalmente&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;2. Consumo por pessoa:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Cada convidado consome, em média:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• 300 gramas de carne 3 latas de refrigerante 1 doce&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;3. Margem de segurança:&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Para evitar falta de produtos:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Acrescentar 6% a mais de carne&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Acrescentar 9 latas extras de refrigerante (total)&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Para doces: não há margem (1 por pessoa)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;4. Classificação do evento (OBRIGATÓRIO)&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Após validar os dados, seu programa deve classificar o evento:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Até 100 pessoas: Evento pequeno&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• De 101 até 200: Evento médio&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Acima de 200: Evento grande&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Saída esperada&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;O programa deve exibir:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Quantidade de carne (em kg)&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Quantidade de refrigerantes (latas)&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Quantidade de doces&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Classificação do evento&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Desenvolvimento adicional obrigatório:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Antes de programar, você deverá:&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Criar um fluxograma-&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Além da entrega do código e do fluxograma, desenvolva um site em HTML que simule como seria a página&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;oficial da empresa. O site deve:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Utilizar imagens relevantes e bem posicionadas;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Organizar os elementos de forma lógica e intuitiva;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• Apresentar um layout atrativo e profissional, adequado à identidade da empresa.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Bom divertimento!&lt;/div&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1200" width="582" x="8" as="geometry" />
        </mxCell>
