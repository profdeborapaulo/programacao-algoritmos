        <attribute name="edited" value="cGVkcm9fMjYyMDQ7TEFCNE1BUTE5OzIwMjYtMDgtMTA7IjA5OjM1OjU5ICI7MzsyNzkw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nome" type="String" array="False" size=""/>
            <output expression="&quot;insira o seu nome: &quot;" newline="True"/>
            <input variable="nome"/>
            <declare name="idade" type="Integer" array="False" size=""/>
            <output expression="&quot;insira a sua idade: &quot;" newline="True"/>
            <input variable="idade"/>
            <if expression="idade&gt;15">
                <then>
                    <if expression="idade&gt;17">
                        <then>
                            <output expression="nome" newline="False"/>
                            <output expression="&quot;o seu voto &#233; obrigat&#243;rio&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="nome" newline="False"/>
                            <output expression="&quot; o seu voto &#233; valido, mas facultativo&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;A idade inserida &#233; invalida&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
