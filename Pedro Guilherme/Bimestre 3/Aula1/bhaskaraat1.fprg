        <attribute name="edited" value="cGVkcm9fMjYyMDQ7TEFCNE1BUTE5OzIwMjYtMDgtMTA7IjA5OjI1OjQxICI7MTsyNzc4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="resultadoa" type="Integer" array="False" size=""/>
            <declare name="resultadob" type="Integer" array="False" size=""/>
            <declare name="delta" type="Integer" array="False" size=""/>
            <declare name="a" type="Integer" array="False" size=""/>
            <declare name="b" type="Integer" array="False" size=""/>
            <declare name="c" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira A, B e C: &quot;" newline="False"/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <assign variable="delta" expression="b*b -4*a*c"/>
            <assign variable="delta" expression="sqrt(delta)"/>
            <assign variable="resultadoa" expression="(-b+delta)/2*a"/>
            <assign variable="resultadob" expression="(-b-delta)/2*a"/>
            <output expression="resultadoa" newline="True"/>
            <output expression="resultadob" newline="True"/>
        </body>
    </function>
</flowgorithm>
