        <attribute name="edited" value="bHVpemFfMjYwMjU7TEFCNE1BUUEwMzsyMDI2LTA4LTEwOyIwODowMzowNSAiOzE7Mjg0Mw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="NomeCida" type="String" array="False" size=""/>
            <declare name="idade" type="Real" array="False" size=""/>
            <output expression="&quot;Escreva seu nome:&quot;" newline="True"/>
            <input variable="NomeCida"/>
            <output expression="&quot;Digite sua idade:&quot;" newline="True"/>
            <input variable="idade"/>
            <if expression="idade &gt;= 16">
                <then>
                    <output expression="&quot;A idade digitada &#233; v&#225;lida&quot;" newline="True"/>
                    <if expression="idade &gt;= 18">
                        <then>
                            <output expression="&quot;Seu voto &#233; obrigat&#243;rio&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Seu voto n&#227;o &#233; obrigat&#243;rio&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;A idade digitada &#233; inv&#225;lida&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
